# MESTIO gateway baseline (DESIGN.md section 4). Every symbol verified against ESP-IDF v6.1 Kconfig
# or the managed components' Kconfig; deviations are recorded in docs/DECISIONS.md.

# Target / flash / partitions
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU / compiler
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y

# PSRAM (N16R8: 8 MB octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Internal-RAM budget (ARCHITECTURE.md section 6.1, gate > 60 KB minimum free with the AP up, 4 WS
# clients and an SNMP walk). Mitigation 1: Wi-Fi/lwIP dynamic buffers (pbufs of every TCP segment,
# Wi-Fi RX/TX in flight) are allocated from PSRAM first. Mitigation 2: large task-only statics
# marked EXT_RAM_BSS_ATTR (alarm engine, event-log tails + writer scratch, history writer scratch,
# SNMP inform table/varbinds, WS snap state, console log buffer) live in PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Console / FreeRTOS / system
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Core dump (ELF is the only format in IDF 6.1; ESP_COREDUMP_DATA_FORMAT_ELF is auto-selected)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y

# Bootloader / OTA rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_WDT_ENABLE=y

# Drivers
CONFIG_UART_ISR_IN_IRAM=y
# Mitigation 3 (IRAM spills into DIRAM .text): the only RMT user is the single WS2812 status LED, so
# its encoder/ISRs need not be IRAM-resident (2.8 KB); PHY IRAM optimisation only speeds up the
# normally-off recovery AP (5.1 KB).
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_ESP_PHY_IRAM_OPT=n

# HTTP server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# lwIP
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=8
CONFIG_LWIP_MAX_UDP_PCBS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=16
# 4 x MSS per socket: enough for a chunked 2 KB stream on a LAN, and it halves the unacked data one
# slow client (recovery AP) can pin per socket (12 httpd sockets).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
CONFIG_LWIP_DHCPS=y
# SNMP transport needs the datagram destination address (AP-interface allowlist exemption).
CONFIG_LWIP_NETBUF_RECVINFO=y

# Ethernet (W5500 via espressif/w5500 registry component)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y

# Wi-Fi recovery AP only
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# mbedTLS 4.x / TF-PSA-Crypto. PSA_WANT_ALG_* are derived from these in
# components/mbedtls/port/include/mbedtls/esp_config.h; HMAC and PBKDF2_HMAC come from the
# TF-PSA-Crypto base crypto_config.h. Needed: HMAC-SHA1/MD5 (SNMPv3 auth), MD5/SHA-1 hashes
# (RFC 3414 password->key), AES-128-CFB (SNMPv3 priv), SHA-256 + PBKDF2-HMAC-SHA256 (passwords).
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CIPHER_MODE_CFB=y
CONFIG_MBEDTLS_MD_C=y
CONFIG_MBEDTLS_MD5_C=y
CONFIG_MBEDTLS_SHA1_C=y
CONFIG_MBEDTLS_SHA256_C=y

# cJSON (espressif/cjson): bound parser recursion on the httpd/async-worker stacks. Store's parsers
# pre-scan depth <= 16 and web/WS bodies nest <= 5, so 32 never rejects a valid document while a
# hostile "[[[[..." body can no longer recurse ~1000 levels (DECISIONS.md, Integrator).
CONFIG_CJSON_NESTING_LIMIT=32

# LittleFS (joltwallet/littlefs)
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y
CONFIG_LITTLEFS_USE_MTIME=y
CONFIG_LITTLEFS_OBJ_NAME_LEN=64

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
