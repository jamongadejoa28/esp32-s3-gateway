# Static UI build hook. Owner: stream G. Contract: components/web/include/web/web_assets.h.
# Included from components/web/CMakeLists.txt after idf_component_register():
#   gw_web_assets(${COMPONENT_LIB})
# adds exactly one source defining gw_web_assets[] / gw_web_assets_count to the target:
#   1. node >= 24 (GW_NODE, $NVM_BIN, ~/.nvm/versions/node/*/bin, PATH), tools/build_web.mjs, web/
#      and node_modules/esbuild exist: ${CMAKE_CURRENT_BINARY_DIR}/web_assets.c is generated by a
#      custom command (node tools/build_web.mjs -> web/dist, then tools/gen_web_assets.py) that
#      DEPENDS on every file below web/ (except dist/, test/, node_modules/), the build script,
#      package*.json and the generator, so editing the UI rebuilds the table. The build FAILS when
#      the UI build fails. Gzip above 256 KiB warns; the LittleFS image enforces actual capacity.
#   2. otherwise, a prebuilt web/dist/manifest.json exists: the table is generated from it (warning).
#   3. otherwise (or -DGW_WEB_ASSETS=OFF): components/web/fallback/web_assets_fallback.c, the empty
#      table, with a warning: the firmware then serves the API and /ws but no UI.
# Several build directories may build at once (one per stream): the node build and the generator
# run under a file lock (cmake -P this file) so they never write web/dist concurrently. The lock is
# web/.dist.lock, next to the directory it protects, so every build of this source tree uses the same
# lock whatever its environment (TMPDIR, sandbox, PrivateTmp); it is created at configure time so the
# web/* configure glob never sees it appear. It must be ignored by VCS (web/.dist.lock).
#
# This file is also a cmake -P script (GW_WEB_SCRIPT=1) for that locked step.

if(CMAKE_SCRIPT_MODE_FILE AND GW_WEB_SCRIPT)
  # ---- script mode: cmake -DGW_WEB_SCRIPT=1 -DGW_ROOT=… -DGW_PYTHON=… -DGW_OUT=… [-DGW_NODE=…] -P …
  foreach(v GW_ROOT GW_PYTHON GW_OUT GW_LOCK)
    if(NOT ${v})
      message(FATAL_ERROR "gw_web_assets script: ${v} not set")
    endif()
  endforeach()
  file(LOCK "${GW_LOCK}" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE lock_rc)
  if(NOT lock_rc EQUAL 0)
    message(FATAL_ERROR "gw_web_assets: cannot lock ${GW_LOCK}: ${lock_rc}")
  endif()
  if(GW_NODE)
    get_filename_component(node_dir "${GW_NODE}" DIRECTORY)
    set(ENV{PATH} "${node_dir}:$ENV{PATH}")
    execute_process(COMMAND "${GW_NODE}" tools/build_web.mjs
                    WORKING_DIRECTORY "${GW_ROOT}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "gw_web_assets: node tools/build_web.mjs failed (${rc})")
    endif()
  endif()
  execute_process(COMMAND "${GW_PYTHON}" tools/gen_web_assets.py
                          --manifest "${GW_ROOT}/web/dist/manifest.json" --out "${GW_OUT}"
                  WORKING_DIRECTORY "${GW_ROOT}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "gw_web_assets: tools/gen_web_assets.py failed (${rc})")
  endif()
  return()
endif()

option(GW_WEB_ASSETS "Embed the web UI (requires node and web/ sources, or a prebuilt web/dist)" ON)
set(GW_NODE "" CACHE FILEPATH "node executable for the web UI build (empty = search nvm and PATH)")
set(GW_NODE_MIN_MAJOR 24)

# Newest node >= GW_NODE_MIN_MAJOR: explicit GW_NODE, $NVM_BIN, ~/.nvm installs (newest first), PATH.
function(_gw_find_node out_var)
  set(cands "")
  if(GW_NODE)
    list(APPEND cands "${GW_NODE}")
  endif()
  if(DEFINED ENV{NVM_BIN})
    list(APPEND cands "$ENV{NVM_BIN}/node")
  endif()
  if(DEFINED ENV{HOME})
    file(GLOB nvm_bins LIST_DIRECTORIES true "$ENV{HOME}/.nvm/versions/node/v*/bin")
    list(SORT nvm_bins COMPARE NATURAL ORDER DESCENDING)
    foreach(d IN LISTS nvm_bins)
      list(APPEND cands "${d}/node")
    endforeach()
  endif()
  find_program(_gw_node_on_path node NO_CACHE)
  if(_gw_node_on_path)
    list(APPEND cands "${_gw_node_on_path}")
  endif()
  foreach(n IN LISTS cands)
    if(NOT EXISTS "${n}" OR IS_DIRECTORY "${n}")
      continue()
    endif()
    execute_process(COMMAND "${n}" --version OUTPUT_VARIABLE ver RESULT_VARIABLE rc
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 20)
    if(rc EQUAL 0 AND ver MATCHES "^v([0-9]+)\\.")
      if(CMAKE_MATCH_1 GREATER_EQUAL GW_NODE_MIN_MAJOR)
        set(${out_var} "${n}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${out_var} "" PARENT_SCOPE)
endfunction()

# Files whose change must rebuild the UI: web/** minus build output, tests and node_modules.
function(_gw_web_inputs gw_root out_var)
  file(GLOB top CONFIGURE_DEPENDS LIST_DIRECTORIES true "${gw_root}/web/*")
  set(files "")
  foreach(e IN LISTS top)
    get_filename_component(name "${e}" NAME)
    if(name MATCHES "^(dist|test|tests|node_modules|\\..*)$")
      continue()
    endif()
    if(IS_DIRECTORY "${e}")
      file(GLOB_RECURSE sub CONFIGURE_DEPENDS LIST_DIRECTORIES false "${e}/*")
      list(APPEND files ${sub})
    else()
      list(APPEND files "${e}")
    endif()
  endforeach()
  foreach(f tools/build_web.mjs package.json package-lock.json MESTIO_Symbol.svg)
    if(EXISTS "${gw_root}/${f}")
      list(APPEND files "${gw_root}/${f}")
    endif()
  endforeach()
  list(SORT files)
  set(${out_var} ${files} PARENT_SCOPE)
endfunction()

function(gw_web_assets target)
  get_filename_component(gw_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(self "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(fallback "${gw_root}/components/web/fallback/web_assets_fallback.c")
  set(out "${CMAKE_CURRENT_BINARY_DIR}/web_assets.c")
  set(GW_WEB_ASSET_TABLE "${out}" CACHE INTERNAL "Web metadata table" FORCE)
  set(GW_WEB_FS_DIR "${CMAKE_CURRENT_BINARY_DIR}/webfs" CACHE INTERNAL "Web LittleFS source" FORCE)
  set(GW_WEB_FS_READY FALSE CACHE INTERNAL "Web filesystem inputs available" FORCE)
  set(manifest "${gw_root}/web/dist/manifest.json")
  idf_build_get_property(python PYTHON)
  set(lock "${gw_root}/web/.dist.lock")

  if(NOT GW_WEB_ASSETS)
    message(WARNING "gw_web_assets: GW_WEB_ASSETS=OFF; embedding the empty fallback table "
                    "(the firmware serves the API and /ws but no UI)")
    target_sources(${target} PRIVATE "${fallback}")
    return()
  endif()

  set(mode "")
  set(why "")
  if(NOT EXISTS "${gw_root}/tools/build_web.mjs" OR NOT IS_DIRECTORY "${gw_root}/web")
    set(why "tools/build_web.mjs or web/ is missing")
  elseif(NOT EXISTS "${gw_root}/node_modules/esbuild/package.json")
    set(why "node_modules/esbuild is missing (run `npm ci` in ${gw_root})")
  else()
    _gw_find_node(node)
    if(node)
      set(mode build)
    else()
      set(why "node >= ${GW_NODE_MIN_MAJOR} not found (set -DGW_NODE=/path/to/node or install it with nvm)")
    endif()
  endif()
  if(NOT mode AND EXISTS "${manifest}")
    set(mode dist)
  endif()
  if(mode AND NOT EXISTS "${lock}")
    file(TOUCH "${lock}")                     # before the web/* glob below records the listing
  endif()

  if(mode STREQUAL "build")
    set(GW_WEB_FS_READY TRUE CACHE INTERNAL "Web filesystem inputs available" FORCE)
    _gw_web_inputs("${gw_root}" inputs)
    message(STATUS "gw_web_assets: web UI built with ${node} (${CMAKE_CURRENT_BINARY_DIR}/web_assets.c)")
    add_custom_command(
      OUTPUT "${out}"
      BYPRODUCTS "${CMAKE_CURRENT_BINARY_DIR}/webfs/.asset-id"
      COMMAND "${CMAKE_COMMAND}" -DGW_WEB_SCRIPT=1 "-DGW_ROOT=${gw_root}" "-DGW_NODE=${node}"
              "-DGW_PYTHON=${python}" "-DGW_OUT=${out}" "-DGW_LOCK=${lock}" -P "${self}"
      DEPENDS ${inputs} "${gw_root}/tools/gen_web_assets.py" "${self}"
      WORKING_DIRECTORY "${gw_root}"
      COMMENT "Building the web UI (node tools/build_web.mjs) and generating web_assets.c"
      VERBATIM)
    target_sources(${target} PRIVATE "${out}")
  elseif(mode STREQUAL "dist")
    set(GW_WEB_FS_READY TRUE CACHE INTERNAL "Web filesystem inputs available" FORCE)
    file(GLOB_RECURSE dist_files CONFIGURE_DEPENDS LIST_DIRECTORIES false "${gw_root}/web/dist/*")
    list(SORT dist_files)
    message(WARNING "gw_web_assets: ${why}; embedding the prebuilt ${manifest} (not rebuilt from web/)")
    add_custom_command(
      OUTPUT "${out}"
      COMMAND "${CMAKE_COMMAND}" -DGW_WEB_SCRIPT=1 "-DGW_ROOT=${gw_root}"
              "-DGW_PYTHON=${python}" "-DGW_OUT=${out}" "-DGW_LOCK=${lock}" -P "${self}"
      BYPRODUCTS "${CMAKE_CURRENT_BINARY_DIR}/webfs/.asset-id"
      DEPENDS ${dist_files} "${gw_root}/tools/gen_web_assets.py" "${self}"
      WORKING_DIRECTORY "${gw_root}"
      COMMENT "Generating web_assets.c from the prebuilt web/dist"
      VERBATIM)
    target_sources(${target} PRIVATE "${out}")
  else()
    message(WARNING "gw_web_assets: ${why} and no prebuilt web/dist; embedding the empty fallback "
                    "table (the firmware serves the API and /ws but no UI)")
    target_sources(${target} PRIVATE "${fallback}")
  endif()
endfunction()

# Called after project(), when partition registration and the application binary target exist.
function(gw_web_images)
  if(NOT GW_WEB_ASSETS)
    return()
  endif()
  if(NOT GW_WEB_FS_READY)
    message(FATAL_ERROR "Web UI enabled but no build tools or prebuilt web/dist are available. Run npm ci or use -DGW_WEB_ASSETS=OFF.")
  endif()
  partition_table_get_partition_info(web_size "--partition-name web_0" "size")
  partition_table_get_partition_info(web_other_size "--partition-name web_1" "size")
  if(NOT web_size EQUAL 524288 OR NOT web_other_size EQUAL web_size)
    message(FATAL_ERROR "web_0 and web_1 must both be 512 KiB")
  endif()
  idf_build_get_property(python PYTHON)
  set(image "${CMAKE_BINARY_DIR}/web.bin")
  add_custom_command(OUTPUT "${image}"
    COMMAND "${python}" "${CMAKE_SOURCE_DIR}/tools/build_web_fs.py"
            --source "${GW_WEB_FS_DIR}" --out "${image}" --size "${web_size}"
    DEPENDS "${GW_WEB_ASSET_TABLE}" "${GW_WEB_FS_DIR}/.asset-id" "${CMAKE_SOURCE_DIR}/tools/build_web_fs.py"
    VERBATIM)
  add_custom_target(gw_web_fs ALL DEPENDS "${image}")
  foreach(part web_0 web_1)
    esp_partition_register_target(${part} "${image}" FLASH_IN_PROJECT DEPENDS gw_web_fs)
  endforeach()
  add_custom_target(gw_ota_package ALL
    COMMAND "${python}" "${CMAKE_SOURCE_DIR}/tools/package_ota.py"
            --app "${CMAKE_BINARY_DIR}/${CMAKE_PROJECT_NAME}.bin" --web "${image}"
            --out "${CMAKE_BINARY_DIR}/${CMAKE_PROJECT_NAME}.gwota"
    DEPENDS gen_project_binary gw_web_fs "${CMAKE_SOURCE_DIR}/tools/package_ota.py"
    VERBATIM)
endfunction()
