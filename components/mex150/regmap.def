/*
 * regmap.def - MEX150 Modbus map: SINGLE SOURCE OF TRUTH for firmware (regmap.c, model.c,
 * service.c), REST /api/v1/meta/registers, SNMP modules, tools/gen_mib.py and the web UI.
 * Source: docs/modbusmap.pdf ("MeX150 표준외부통신 모드버스맵"). Korean names are verbatim from
 * the map (REGISTER NAME column for registers/coils, bit-table labels for REGBIT/FIELD rows).
 *
 * Do NOT include this file directly from C: define the row macros you need and
 * #include "mex150/regmap_x.h" (it defines the column tokens, includes this file, then #undefs
 * everything). Python tools parse it line by line: exactly one row per line, no continuation
 * lines, strings without escaped quotes or commas.
 *
 * REG(key, addr, scale, sign, access, min, max, disabled, flags, group, unit, ko, en)
 *   addr      4xxxx holding register address (PDU address = addr - 40001)
 *   scale     divisor of the integer wire value: 1 or 10 (x10 = one decimal)
 *   sign      U = unsigned 16-bit, S = signed (two's complement) 16-bit
 *   access    RO / RW (FC06 single write; FC16 is not supported by MEX150)
 *   min, max  valid raw (decoded integer) range, inclusive
 *   disabled  NONE, or the raw sentinel meaning "function disabled" (accepted besides min..max)
 *   flags     0 or '|' of: STOPPED (write only while stopped), SNMP_RW (writable column in
 *             mexSetpointTable), RUNBIT (40005: bit0 run, bits15..8 delay; read-back compares
 *             low byte), BITS (bitfield word: UI shows REGBIT/FIELD rows, not a number)
 *   group     status control setpoint deviation delay calibration limits options info
 *   unit      display unit ("" none); s = seconds, h = hours
 * REGBIT(key, addr, bit, ko, en)                    one bit of a BITS register (1 = active)
 * FIELD(key, addr, lsb, width, unit, ko, en)        multi-bit field of a register
 * COIL(key, n, group, ko, en)                       coil n (1..32, FC01, read-only; FC05 disabled)
 * ENUM(regkey, value, ko, en)                       display label of a raw value of REG regkey
 */

/* ---- Holding registers (FC03 / FC06) ---- */
REG(inputs,        40002,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "입력포트",       "Input port")
REG(alarm_detail1, 40003,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "경보내용1",      "Alarm detail 1")
REG(alarm_detail2, 40004,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "경보내용2",      "Alarm detail 2")
REG(run,           40005,  1, U, RW,     0,     1, NONE, RUNBIT,          control,     "",   "운전/정지",      "Run/Stop")
REG(cool_prop,     40006,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "냉방비례",       "Cooling proportional")
REG(heat_prop,     40007,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "난방비례",       "Heating proportional")
REG(hum_prop,      40008,  1, U, RO,     0, 65535, NONE, BITS,            status,      "",   "가습비례",       "Humidifying proportional")
REG(current,       40011, 10, U, RO,     0,   999, NONE, 0,               status,      "A",  "현재전류",       "Current")
REG(set_temp,      40012, 10, U, RW,    50,   500, NONE, SNMP_RW,         setpoint,    "°C", "설정온도",       "Temperature setpoint")
REG(set_hum,       40013, 10, U, RW,   200,   800, NONE, SNMP_RW,         setpoint,    "%",  "설정습도",       "Humidity setpoint")
REG(cool_dev,      40014, 10, U, RW,     1,   100, NONE, SNMP_RW,         deviation,   "°C", "냉방편차",       "Cooling deviation")
REG(heat_dev,      40015, 10, U, RW,     1,   100, NONE, SNMP_RW,         deviation,   "°C", "난방편차",       "Heating deviation")
REG(hum_dev,       40016, 10, U, RW,    10,   100, NONE, SNMP_RW,         deviation,   "%",  "가습편차",       "Humidifying deviation")
REG(dehum_dev,     40017, 10, U, RW,    10,   100, NONE, SNMP_RW,         deviation,   "%",  "제습편차",       "Dehumidifying deviation")
REG(run_delay,     40018,  1, U, RW,     1,   180, NONE, SNMP_RW,         delay,       "s",  "운전지연",       "Run delay")
REG(stop_delay,    40019,  1, U, RW,     1,   180, NONE, SNMP_RW,         delay,       "s",  "정지지연",       "Stop delay")
REG(dev_no,        40020,  1, U, RO,     1,    99, NONE, 0,               info,        "",   "장비번호",       "Device number")
REG(temp_offset,   40021, 10, S, RW,  -100,   100, NONE, STOPPED,         calibration, "°C", "온도보정",       "Temperature offset")
REG(hum_offset,    40022, 10, S, RW,  -300,   300, NONE, STOPPED,         calibration, "%",  "습도보정",       "Humidity offset")
REG(hi_temp,       40027, 10, U, RW,   250,   500,  249, STOPPED|SNMP_RW, limits,      "°C", "고온설정",       "High temperature limit")
REG(lo_temp,       40028, 10, U, RW,    50,   200,   49, STOPPED|SNMP_RW, limits,      "°C", "저온설정",       "Low temperature limit")
REG(hi_hum,        40029, 10, U, RW,   600,   900,  599, STOPPED|SNMP_RW, limits,      "%",  "고습설정",       "High humidity limit")
REG(lo_hum,        40030, 10, U, RW,   100,   400,   99, STOPPED|SNMP_RW, limits,      "%",  "저습설정",       "Low humidity limit")
REG(temp,          40036, 10, S, RO,  -250,   850, NONE, 0,               status,      "°C", "현재온도",       "Temperature")
REG(hum,           40037, 10, U, RO,     0,   990, NONE, 0,               status,      "%",  "현재습도",       "Humidity")
REG(no_hum_cool,   40053,  1, U, RW,     0,     1, NONE, STOPPED,         options,     "",   "냉방시가습금지", "Humidifying while cooling")
REG(no_dehum_heat, 40054,  1, U, RW,     0,     1, NONE, STOPPED,         options,     "",   "난방시제습금지", "Dehumidifying while heating")
REG(cyl_hours,     40059,  1, U, RW,  1000, 20000, NONE, STOPPED,         options,     "h",  "실린더오염시간", "Cylinder contamination time")

/* ---- Bitfields (bit 0 = LSB) ---- */
REGBIT(in1,          40002,  8, "1",        "Input 1")
REGBIT(in2,          40002,  9, "2",        "Input 2")
REGBIT(in3,          40002, 10, "3",        "Input 3")
REGBIT(in4,          40002, 11, "4",        "Input 4")
REGBIT(in5,          40002, 12, "5",        "Input 5")
REGBIT(in6,          40002, 13, "6",        "Input 6")
REGBIT(in7,          40002, 14, "7",        "Input 7")
REGBIT(in8,          40002, 15, "8",        "Input 8")
REGBIT(in9,          40002,  0, "9",        "Input 9")
REGBIT(in10,         40002,  1, "10",       "Input 10")
REGBIT(in11,         40002,  2, "11",       "Input 11")
REGBIT(ad1_blower,   40003,  0, "송풍",     "Blower")
REGBIT(ad1_cool1,    40003,  1, "냉방1",    "Cooling 1")
REGBIT(ad1_cool2,    40003,  2, "냉방2",    "Cooling 2")
REGBIT(ad1_heat,     40003,  3, "난방",     "Heating")
REGBIT(ad1_hum,      40003,  4, "가습",     "Humidifier")
REGBIT(ad1_fire,     40003,  5, "화재",     "Fire")
REGBIT(ad1_leak,     40003,  6, "누수",     "Leak")
REGBIT(ad1_contam,   40003,  7, "오염",     "Contamination")
REGBIT(ad1_supply,   40003,  8, "급수",     "Water supply")
REGBIT(ad1_drain,    40003,  9, "배수",     "Drain")
REGBIT(ad1_led6,     40003, 10, "LED-6",    "LED 6")
REGBIT(ad1_led5,     40003, 11, "LED-5",    "LED 5")
REGBIT(ad1_led4,     40003, 12, "LED-4",    "LED 4")
REGBIT(ad1_led3,     40003, 13, "LED-3",    "LED 3")
REGBIT(ad1_led2,     40003, 14, "LED-2",    "LED 2")
REGBIT(ad1_led1,     40003, 15, "LED-1",    "LED 1")
REGBIT(ad2_run_delay, 40004, 0, "운전지연", "Run delay active")
REGBIT(ad2_stop_delay, 40004, 1, "정지지연", "Stop delay active")
REGBIT(ad2_cool3,    40004,  2, "냉방3",    "Cooling 3")
REGBIT(ad2_sensor,   40004, 11, "센서",     "Sensor")
REGBIT(ad2_hi_temp,  40004, 12, "고온",     "High temperature")
REGBIT(ad2_lo_temp,  40004, 13, "저온",     "Low temperature")
REGBIT(ad2_hi_hum,   40004, 14, "고습",     "High humidity")
REGBIT(ad2_lo_hum,   40004, 15, "저습",     "Low humidity")
REGBIT(run_on,       40005,  0, "운전",     "Running")
FIELD(run_delay_left, 40005, 8, 8, "s",  "지연시간", "Delay remaining")
REGBIT(cp_cool1,     40006,  8, "냉방1",    "Cooling 1")
REGBIT(cp_cool2,     40006,  9, "냉방2",    "Cooling 2")
REGBIT(cp_cool3,     40006, 10, "냉방3",    "Cooling 3")
REGBIT(cp_cool4,     40006, 11, "냉방4",    "Cooling 4")
REGBIT(cp_dehum1,    40006, 12, "제습1",    "Dehumidifying 1")
REGBIT(cp_dehum2,    40006, 13, "제습2",    "Dehumidifying 2")
REGBIT(cp_dehum3,    40006, 14, "제습3",    "Dehumidifying 3")
REGBIT(cp_dehum4,    40006, 15, "제습4",    "Dehumidifying 4")
REGBIT(hp_heat1,     40007,  8, "난방1",    "Heating 1")
REGBIT(hp_heat2,     40007,  9, "난방2",    "Heating 2")
REGBIT(hp_heat3,     40007, 10, "난방3",    "Heating 3")
REGBIT(hp_heat4,     40007, 11, "난방4",    "Heating 4")
REGBIT(hp_heat5,     40007, 12, "난방5",    "Heating 5")
REGBIT(up_hum1,      40008,  8, "가습1",    "Humidifying 1")
REGBIT(up_hum2,      40008,  9, "가습2",    "Humidifying 2")
REGBIT(up_supply,    40008, 14, "급수",     "Water supply")
REGBIT(up_drain,     40008, 15, "배수",     "Drain")

/* ---- Coils (FC01, read in blocks of 8; bit n-1 of mex_snapshot_t.coils) ---- */
COIL(run_blower,        1, status, "송풍기운전", "Blower")
COIL(run_cool1,         2, status, "냉방1운전",  "Cooling 1")
COIL(run_cool2,         3, status, "냉방2운전",  "Cooling 2")
COIL(run_heat1,         4, status, "난방1운전",  "Heating 1")
COIL(run_heat2,         5, status, "난방2운전",  "Heating 2")
COIL(run_heat3,         6, status, "난방3운전",  "Heating 3")
COIL(run_heat4,         7, status, "난방4운전",  "Heating 4")
COIL(run_hum1,          8, status, "가습1운전",  "Humidifying 1")
COIL(run_hum2,          9, status, "가습2운전",  "Humidifying 2")
COIL(run_supply,       10, status, "급수운전",   "Water supply")
COIL(run_drain,        11, status, "배수운전",   "Drain")
COIL(run_cooling,      12, status, "냉방운전",   "Cooling")
COIL(run_heating,      13, status, "난방운전",   "Heating")
COIL(run_humidifying,  14, status, "가습운전",   "Humidifying")
COIL(run_dehumidifying, 15, status, "제습운전",  "Dehumidifying")
COIL(run_cool3,        16, status, "냉방3운전",  "Cooling 3")
COIL(alm_blower,       17, alarm,  "송풍기경보", "Blower alarm")
COIL(alm_cool1,        18, alarm,  "냉방1경보",  "Cooling 1 alarm")
COIL(alm_cool2,        19, alarm,  "냉방2경보",  "Cooling 2 alarm")
COIL(alm_heater,       20, alarm,  "난방기경보", "Heater alarm")
COIL(alm_humidifier,   21, alarm,  "가습기경보", "Humidifier alarm")
COIL(alm_sensor,       22, alarm,  "센서경보",   "Sensor alarm")
COIL(alm_leak,         23, alarm,  "누수경보",   "Leak alarm")
COIL(alm_supply,       24, alarm,  "급수경보",   "Water supply alarm")
COIL(alm_drain,        25, alarm,  "배수경보",   "Drain alarm")
COIL(alm_low_temp,     26, alarm,  "저온경보",   "Low temperature alarm")
COIL(alm_high_temp,    27, alarm,  "고온경보",   "High temperature alarm")
COIL(alm_low_hum,      28, alarm,  "저습경보",   "Low humidity alarm")
COIL(alm_high_hum,     29, alarm,  "고습경보",   "High humidity alarm")
COIL(alm_fire,         30, alarm,  "화재경보",   "Fire alarm")
COIL(alm_cool3,        31, alarm,  "냉방3경보",  "Cooling 3 alarm")
COIL(alm_any,          32, alarm,  "통합경보",   "Combined alarm")

/* ---- Value labels ---- */
ENUM(run,           0, "정지", "Stop")
ENUM(run,           1, "운전", "Run")
ENUM(no_hum_cool,   0, "사용", "Allowed")
ENUM(no_hum_cool,   1, "금지", "Prohibited")
ENUM(no_dehum_heat, 0, "사용", "Allowed")
ENUM(no_dehum_heat, 1, "금지", "Prohibited")
