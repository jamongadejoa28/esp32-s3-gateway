/*
 * api_routes.def - the complete REST route table (docs/API.md §3). SINGLE SOURCE for the device
 * router (api_routes.c builds web_route_t[] with handlers) and the pure metadata table
 * (web_routes.c, checked against API.md by tests/test_web_routes.py). Default-deny: anything not
 * listed here answers 404.
 *
 * ROUTE(method, pattern, min_role, flags, max_body, handler)
 *   method   M_GET | M_POST | M_PUT | M_DELETE
 *   min_role R_NONE (public) | R_VIEWER | R_OPERATOR | R_ADMIN
 *   flags    F_0 or an OR of F_CSRF (X-CSRF-Token), F_MC (reachable while must_change),
 *            F_RAW (handler streams the body), F_SLOW (async worker), F_NOTOUCH (no idle refresh)
 *   max_body B_NONE (no body) | B_JSON (8 KB) | B_IMPORT (32 KB) | B_OTA (3 MB)
 * The expanding file defines these tokens; one row per line.
 */

ROUTE(M_POST,   "/api/v1/auth/login",                     R_NONE,     F_SLOW,                   B_JSON,   h_auth_login)
ROUTE(M_POST,   "/api/v1/auth/logout",                    R_VIEWER,   F_CSRF | F_MC,            B_NONE,   h_auth_logout)
ROUTE(M_GET,    "/api/v1/session",                        R_NONE,     F_MC | F_NOTOUCH,         B_NONE,   h_session)
ROUTE(M_POST,   "/api/v1/auth/password",                  R_VIEWER,   F_CSRF | F_MC | F_SLOW,   B_JSON,   h_auth_password)
ROUTE(M_GET,    "/api/v1/meta/registers",                 R_VIEWER,   F_0,                      B_NONE,   h_meta_registers)
ROUTE(M_GET,    "/api/v1/meta/alarms",                    R_VIEWER,   F_0,                      B_NONE,   h_meta_alarms)
ROUTE(M_GET,    "/api/v1/system/info",                    R_VIEWER,   F_0,                      B_NONE,   h_system_info)
ROUTE(M_GET,    "/api/v1/system/network",                 R_ADMIN,    F_0,                      B_NONE,   h_system_network)
ROUTE(M_GET,    "/api/v1/devices",                        R_VIEWER,   F_0,                      B_NONE,   h_devices)
ROUTE(M_GET,    "/api/v1/devices/{d}/live",               R_VIEWER,   F_0,                      B_NONE,   h_device_live)
ROUTE(M_PUT,    "/api/v1/devices/{d}/registers/{addr}",   R_OPERATOR, F_CSRF | F_SLOW,          B_JSON,   h_register_write)
ROUTE(M_POST,   "/api/v1/devices/{d}/run",                R_OPERATOR, F_CSRF | F_SLOW,          B_JSON,   h_device_run)
ROUTE(M_GET,    "/api/v1/devices/{d}/commands/{id}",      R_OPERATOR, F_0,                      B_NONE,   h_device_command)
ROUTE(M_GET,    "/api/v1/devices/{d}/history",            R_VIEWER,   F_0,                      B_NONE,   h_device_history)
ROUTE(M_GET,    "/api/v1/devices/{d}/history.csv",        R_VIEWER,   F_0,                      B_NONE,   h_device_history_csv)
ROUTE(M_GET,    "/api/v1/devices/{d}/stats",              R_VIEWER,   F_0,                      B_NONE,   h_device_stats)
ROUTE(M_POST,   "/api/v1/devices/{d}/stats/reset",        R_ADMIN,    F_CSRF,                   B_NONE,   h_device_stats_reset)
ROUTE(M_GET,    "/api/v1/alarms/active",                  R_VIEWER,   F_0,                      B_NONE,   h_alarms_active)
ROUTE(M_POST,   "/api/v1/alarms/ack",                     R_OPERATOR, F_CSRF,                   B_JSON,   h_alarms_ack)
ROUTE(M_GET,    "/api/v1/alarms/history",                 R_VIEWER,   F_0,                      B_NONE,   h_alarms_history)
ROUTE(M_GET,    "/api/v1/alarms/history.csv",             R_VIEWER,   F_0,                      B_NONE,   h_alarms_history_csv)
ROUTE(M_GET,    "/api/v1/config/rules",                   R_VIEWER,   F_0,                      B_NONE,   h_config_rules_get)
ROUTE(M_PUT,    "/api/v1/config/rules",                   R_ADMIN,    F_CSRF,                   B_JSON,   h_config_rules_put)
ROUTE(M_GET,    "/api/v1/config/alarms",                  R_VIEWER,   F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/alarms",                  R_ADMIN,    F_CSRF,                   B_JSON,   h_config_section_put)
ROUTE(M_GET,    "/api/v1/config/general",                 R_VIEWER,   F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/general",                 R_ADMIN,    F_CSRF,                   B_JSON,   h_config_section_put)
ROUTE(M_GET,    "/api/v1/config/network",                 R_ADMIN,    F_0,                      B_NONE,   h_config_network_get)
ROUTE(M_PUT,    "/api/v1/config/network",                 R_ADMIN,    F_CSRF,                   B_JSON,   h_config_network_put)
ROUTE(M_POST,   "/api/v1/config/network/confirm",         R_ADMIN,    F_CSRF,                   B_NONE,   h_config_network_confirm)
ROUTE(M_GET,    "/api/v1/config/modbus",                  R_VIEWER,   F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/modbus",                  R_ADMIN,    F_CSRF,                   B_JSON,   h_config_section_put)
ROUTE(M_GET,    "/api/v1/config/snmp",                    R_ADMIN,    F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/snmp",                    R_ADMIN,    F_CSRF | F_SLOW,          B_JSON,   h_config_snmp_put)
ROUTE(M_GET,    "/api/v1/snmp/mib",                       R_VIEWER,   F_0,                      B_NONE,   h_snmp_mib)
ROUTE(M_POST,   "/api/v1/snmp/test-trap",                 R_ADMIN,    F_CSRF | F_SLOW,          B_NONE,   h_snmp_test_trap)
ROUTE(M_GET,    "/api/v1/config/time",                    R_VIEWER,   F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/time",                    R_ADMIN,    F_CSRF,                   B_JSON,   h_config_section_put)
ROUTE(M_POST,   "/api/v1/time",                           R_ADMIN,    F_CSRF,                   B_JSON,   h_time_set)
ROUTE(M_GET,    "/api/v1/config/security",                R_ADMIN,    F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/security",                R_ADMIN,    F_CSRF,                   B_JSON,   h_config_security_put)
ROUTE(M_GET,    "/api/v1/config/notify",                  R_ADMIN,    F_0,                      B_NONE,   h_config_section_get)
ROUTE(M_PUT,    "/api/v1/config/notify",                  R_ADMIN,    F_CSRF,                   B_JSON,   h_config_section_put)
ROUTE(M_GET,    "/api/v1/users",                          R_ADMIN,    F_0,                      B_NONE,   h_users_list)
ROUTE(M_POST,   "/api/v1/users",                          R_ADMIN,    F_CSRF | F_SLOW,          B_JSON,   h_users_create)
ROUTE(M_PUT,    "/api/v1/users/{name}",                   R_ADMIN,    F_CSRF | F_SLOW,          B_JSON,   h_users_update)
ROUTE(M_DELETE, "/api/v1/users/{name}",                   R_ADMIN,    F_CSRF,                   B_NONE,   h_users_delete)
ROUTE(M_GET,    "/api/v1/system/firmware",                R_ADMIN,    F_0,                      B_NONE,   h_firmware_info)
ROUTE(M_POST,   "/api/v1/system/firmware",                R_ADMIN,    F_CSRF | F_RAW,           B_OTA,    h_firmware_upload)
ROUTE(M_POST,   "/api/v1/system/firmware/rollback",       R_ADMIN,    F_CSRF,                   B_NONE,   h_firmware_rollback)
ROUTE(M_GET,    "/api/v1/system/config/export",           R_ADMIN,    F_0,                      B_NONE,   h_config_export)
ROUTE(M_POST,   "/api/v1/system/config/import",           R_ADMIN,    F_CSRF,                   B_IMPORT, h_config_import)
ROUTE(M_POST,   "/api/v1/system/reboot",                  R_ADMIN,    F_CSRF,                   B_NONE,   h_system_reboot)
ROUTE(M_POST,   "/api/v1/system/factory-reset",           R_ADMIN,    F_CSRF | F_SLOW,          B_JSON,   h_factory_reset)
ROUTE(M_GET,    "/api/v1/system/logs",                    R_ADMIN,    F_0,                      B_NONE,   h_system_logs)
ROUTE(M_GET,    "/api/v1/system/coredump",                R_ADMIN,    F_0,                      B_NONE,   h_coredump)
