# snmp_traps_fix.cmake - build-time fix of upstream lwIP apps/snmp/snmp_traps.c (IDF 6.1).
#
# Upstream puts the two leading varbinds of every SNMPv2-Trap / InformRequest PDU at
# 1.3.6.1.2.1.1.3 and 1.3.6.1.6.3.1.1.4.1, without the ".0" instance arc that RFC 3416 4.2.6
# requires (sysUpTime.0, snmpTrapOID.0). Managers look the trap OID up as snmpTrapOID.0 (net-snmp
# snmptrapd: "Cannot find TrapOID in TRAP2 PDU", the PDU is dropped and an inform never acknowledged).
# The fix appends the instance arc right after the varbind array is initialised; nothing else changes.
#
# Inputs: SNMP_TRAPS_IN (upstream snmp_traps.c), SNMP_TRAPS_OUT (fixed copy; rewritten only when its
# content changes). Used by components/snmp_lwip/CMakeLists.txt (include()) and by the host tests
# (cmake -DSNMP_TRAPS_IN=... -DSNMP_TRAPS_OUT=... -P snmp_traps_fix.cmake). Fails loudly when upstream
# no longer matches the expected shape, so a changed lwIP is re-checked instead of silently mis-fixed.

if(NOT DEFINED SNMP_TRAPS_IN OR NOT DEFINED SNMP_TRAPS_OUT)
  message(FATAL_ERROR "snmp_traps_fix.cmake: SNMP_TRAPS_IN and SNMP_TRAPS_OUT are required")
endif()

file(READ "${SNMP_TRAPS_IN}" _snmp_traps_src)

set(_snmp_traps_anchor "  snmp_v2_special_varbinds[0].next = &snmp_v2_special_varbinds[1];\n")

# Each marker must occur exactly once: the two 8/10-arc OIDs without instance and the anchor line.
# (Checked one by one: the anchor contains ';', which a CMake list would split.)
function(_snmp_traps_expect_once text marker)
  string(FIND "${text}" "${marker}" _first)
  string(FIND "${text}" "${marker}" _last REVERSE)
  if(_first EQUAL -1 OR NOT _first EQUAL _last)
    message(FATAL_ERROR "snmp_traps_fix.cmake: upstream ${SNMP_TRAPS_IN} changed (marker '${marker}' "
                        "not found exactly once); re-check the sysUpTime.0/snmpTrapOID.0 fix")
  endif()
endfunction()
_snmp_traps_expect_once("${_snmp_traps_src}" "{1, 3, 6, 1, 2, 1, 1, 3}       /* oid for sysUpTime */")
_snmp_traps_expect_once("${_snmp_traps_src}" "{1, 3, 6, 1, 6, 3, 1, 1, 4, 1} /* oid for snmpTrapOID */")
_snmp_traps_expect_once("${_snmp_traps_src}" "${_snmp_traps_anchor}")

string(CONCAT _snmp_traps_fix
  "  /* snmp_lwip fix (snmp_traps_fix.cmake): RFC 3416 4.2.6 instances sysUpTime.0, snmpTrapOID.0 */\n"
  "  snmp_v2_special_varbinds[0].oid.id[snmp_v2_special_varbinds[0].oid.len++] = 0;\n"
  "  snmp_v2_special_varbinds[1].oid.id[snmp_v2_special_varbinds[1].oid.len++] = 0;\n")
string(REPLACE "${_snmp_traps_anchor}" "${_snmp_traps_anchor}${_snmp_traps_fix}" _snmp_traps_out
       "${_snmp_traps_src}")
string(CONCAT _snmp_traps_out
  "/* GENERATED by components/snmp_lwip/snmp_traps_fix.cmake from\n"
  " * ${SNMP_TRAPS_IN}\n"
  " * Do not edit. */\n"
  "${_snmp_traps_out}")

set(_snmp_traps_old "")
if(EXISTS "${SNMP_TRAPS_OUT}")
  file(READ "${SNMP_TRAPS_OUT}" _snmp_traps_old)
endif()
if(NOT _snmp_traps_old STREQUAL _snmp_traps_out)
  file(WRITE "${SNMP_TRAPS_OUT}" "${_snmp_traps_out}")
endif()
