{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestio.invalid/gw/api/v1/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "ip4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$",
      "description": "IPv4 dotted quad"
    },
    "ip4_opt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ],
      "description": "IPv4 or \"\" (none)"
    },
    "cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(3[0-2]|[12]?[0-9]))?$",
      "description": "a.b.c.d/n (bare address = /32); host bits must be zero"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$",
      "description": "IPv4 or DNS name"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$",
      "description": "RFC 1123 label"
    },
    "text": {
      "type": "string",
      "maxLength": 63,
      "description": "UTF-8, at most 63 bytes (firmware checks bytes; maxLength is only an upper bound)"
    },
    "user_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,10}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "viewer",
        "operator",
        "admin"
      ]
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "at least 10 characters (code points) and at most 64 UTF-8 bytes (policy); maxLength is only an upper bound, clients check bytes"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "128-bit base64url"
    },
    "dev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "device index"
    },
    "sev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "0 info, 1 minor, 2 major, 3 critical"
    },
    "epoch_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds UTC"
    },
    "epoch_ms_opt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "alarm_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "alarm_key": {
      "type": "string",
      "pattern": "^[0-3]:[a-z][a-z0-9_]{0,31}$",
      "description": "<dev>:<alarm id>"
    },
    "reg_addr_key": {
      "type": "string",
      "pattern": "^400[0-5][0-9]$",
      "description": "holding register address as object key"
    },
    "raw": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 65535,
      "description": "register raw (regmap.h): sign-extended for signed rows, the full 16-bit word for bitfield rows and 40005"
    },
    "wstate": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "rejected",
        "uncertain"
      ]
    },
    "write_reason": {
      "type": "string",
      "pattern": "^(unknown_register|readonly|range|running_interlock|offline|busy|no_ack|verify_mismatch|cancelled|exception:[0-9]{1,3})$"
    },
    "version": {
      "type": "string",
      "maxLength": 31
    },
    "secret_text": {
      "type": "string",
      "maxLength": 64,
      "description": "write-only; never returned"
    }
  }
}
