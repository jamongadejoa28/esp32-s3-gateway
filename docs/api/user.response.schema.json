{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestio.invalid/gw/api/v1/user.response.schema.json",
  "title": "POST /users 201, PUT /users/{name} 200",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/user_name"
    },
    "role": {
