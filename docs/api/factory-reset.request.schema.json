  "$id": "https://mestio.invalid/gw/api/v1/factory-reset.request.schema.json",
  "title": "POST /system/factory-reset",
  "type": "object",
  "properties": {
    "password": {
      "$ref": "common.schema.json#/$defs/password"
    },
    "confirm": {
      "const": "RESET"
