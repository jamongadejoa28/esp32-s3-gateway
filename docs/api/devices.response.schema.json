{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestio.invalid/gw/api/v1/devices.response.schema.json",
  "title": "GET /devices",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/dev"
      },
      "name": {
        "type": "string",
        "maxLength": 23,
        "description": "UTF-8, at most 23 bytes (firmware checks bytes; maxLength is only an upper bound)"
      },
      "slave": {
        "type": "integer",
        "minimum": 1,
        "maximum": 247
      },
      "enabled": {
        "type": "boolean"
      },
      "online": {
        "type": "boolean"
      },
      "last_ms": {
        "$ref": "common.schema.json#/$defs/epoch_ms_opt"
      },
      "seq": {
        "$ref": "common.schema.json#/$defs/u32"
      },
      "template_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 15,
        "description": "ID from GET /meta/device-templates. Omitted legacy requests retain the existing ID or default to mex150."
      },
      "display_mask": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "description": "Per-device display flags (bit = template channel ID). Does not disable polling, alarm detection or writes."
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "slave",
      "enabled",
      "online",
      "last_ms",
      "seq",
      "template_id"
    ]
  }
}
