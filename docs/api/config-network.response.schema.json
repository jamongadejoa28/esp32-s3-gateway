{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestio.invalid/gw/api/v1/config-network.response.schema.json",
  "title": "GET /config/network",
  "description": "Committed configuration. 'provisional' describes a pending change (null when none).",
  "type": "object",
  "properties": {
    "eth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "static",
            "dhcp"
          ]
        },
        "ip": {
          "$ref": "common.schema.json#/$defs/ip4"
        },
        "mask": {
          "$ref": "common.schema.json#/$defs/ip4"
        },
        "gw": {
          "$ref": "common.schema.json#/$defs/ip4_opt"
        },
        "dns1": {
          "$ref": "common.schema.json#/$defs/ip4_opt"
        },
        "dns2": {
          "$ref": "common.schema.json#/$defs/ip4_opt"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "ip",
        "mask",
        "gw",
        "dns1",
        "dns2"
      ]
    },
    "hostname": {
      "$ref": "common.schema.json#/$defs/hostname"
    },
    "ap": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "boolean"
        },
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "psk_set": {
          "type": "boolean"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "idle_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "fallback_after_s": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      },
      "additionalProperties": false,
      "required": [
        "fallback",
        "ssid",
        "psk_set",
        "channel",
        "idle_min",
        "fallback_after_s"
      ]
    },
    "provisional": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "apply_pending",
                "await_confirm"
              ]
            },
            "left_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "left_s"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "eth",
    "hostname",
    "ap",
    "provisional"
  ]
}
