          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 1500
        }
      },
      "additionalProperties": false,
      "required": [
        "temp",
        "hum",
        "cur",
        "st",
        "sh"
      ]
    },
    "min": {
      "type": "object",
      "properties": {
        "temp": {
          "type": "array",
