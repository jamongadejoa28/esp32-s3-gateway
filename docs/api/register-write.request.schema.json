{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestio.invalid/gw/api/v1/register-write.request.schema.json",
  "title": "PUT /devices/{d}/registers/{addr}",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "scaled value, e.g. 23.5"
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "raw": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "required": [
        "raw"
      ]
    }
  ]
}
